{
  // TypeScript project for the contracts package.
  //
  // Generated files are intentionally import-free: cross-package names
  // (CEFR, ScenarioDifficulty, ListParams, ...) are declared as ambient
  // aliases in src/index.ts (see its header comment). This config makes
  // every file under src part of one program, so editors and
  // `tsc -p packages/contracts` resolve those names deterministically.
  //
  // Note: a bare `tsc src/some-file.ts` run (explicit file list, no
  // project) ignores tsconfig.json and cannot see ambient declarations —
  // use `tsc -p packages/contracts` or the editor's project instead.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
