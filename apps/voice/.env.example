STT_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional extra top-level chat-completions param, e.g. reasoning_effort=none
# for reasoning models. Leave empty to not send it.
LLM_REASONING_EFFORT=
# Client identity for proxied OpenAI-compatible endpoints (custom UA + session header).
LLM_USER_AGENT=engflex-voice/0.1
TTS_API_KEY=
# Synthesis model, then the optional voice identity (empty = provider default).
VOICE_MODEL=s2.1-pro-free
VOICE_ID=
# Rate the bot's audio is synthesized at; must be one the TTS engine accepts
# (Fish PCM: 8000/16000/24000/32000/44100). A mismatch fails silently.
AUDIO_OUT_SAMPLE_RATE=24000
# Local Piper voices (models/<voice>.onnx) are used only by the live e2e
# fixture to synthesize the fake-mic WAV; the engine does not read this.
API_URL=http://localhost:8000
INTERNAL_SECRET=dev-internal-secret
MAX_DURATION_SEC=300
IDLE_TIMEOUT_SEC=300
SENTRY_DSN=
# Turn batch callback to Go (at-most-once; a failed batch is dropped).
TURNS_POST_TIMEOUT_SEC=30
# Analysis (separate SDK client; structured output attempted first).
ANALYZE_TIMEOUT_SEC=60
ANALYZE_SESSION_PREFIX=engflex-analyze
ANALYSIS_STRUCTURED_OUTPUT=True
# Pronunciation scoring device; empty = auto (cuda when available, else cpu).
SPEECH_DEVICE=
# Reference voice for pronunciation scoring (library default gtts needs the
# network on first use of each sentence; piper is offline via piper-tts).
OPENPRONOUNCE_TTS=piper
# Persist to skip re-synthesizing repeated sentences; HF_HUB_OFFLINE=1 works
# once the weights are cached.
OPENPRONOUNCE_CACHE_DIR=
