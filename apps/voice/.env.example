DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_NAME=gpt-4o-mini
# Optional extra top-level chat-completions param, e.g. reasoning_effort=none
# for reasoning models. Leave empty to not send it.
LLM_REASONING_EFFORT=
# Client identity for proxied OpenAI-compatible endpoints (custom UA + session header).
OPENCODE_USER_AGENT=engflex-voice/0.1
PIPER_VOICE=en_US-lessac-high
MODELS_DIR=./models
API_URL=http://localhost:8000
INTERNAL_SECRET=dev-internal-secret
MAX_DURATION_SEC=300
IDLE_TIMEOUT_SEC=300
SENTRY_DSN=
# Turn batch callback to Go (at-most-once; a failed batch is dropped).
TURNS_POST_TIMEOUT_SEC=30
# Analysis (separate SDK client; structured output attempted first).
ANALYZE_TIMEOUT_SEC=60
ANALYZE_SESSION_PREFIX=engflex-analyze
ANALYSIS_STRUCTURED_OUTPUT=True
