# Clerk
# Clerk publishable key (required)
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (required)
CLERK_SECRET_KEY=
# Sentry browser DSN, JS project (public key; empty = web monitoring disabled)
VITE_SENTRY_DSN=

# Server-only MinIO media forward (all TOEIC images/audio use /api/media).
# For a container deployment, set the endpoint to the reachable MinIO hostname.
MEDIA_INTERNAL_ENDPOINT=http://localhost:9000
MEDIA_BUCKET=lesson-audio
